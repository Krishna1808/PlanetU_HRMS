// PlanetU HRMS - Prisma Schema
// Foundation + Employee Management Module (Strictly scoped)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT_SUPER_ADMIN
  HR_ADMIN
  MANAGER
  FINANCE
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DocumentType {
  RESUME
  ID_PROOF
  OFFER_LETTER
  EXPERIENCE_LETTER
  EDUCATION_CERTIFICATE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum LeaveAccrualFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  NONE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTransactionType {
  ACCRUAL
  DEBIT_APPLICATION
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
  CARRY_FORWARD
}

enum LeaveHalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum PunchSource {
  WEB
  MANUAL_OVERRIDE
}

enum PayrollBatchStatus {
  DRAFT
  LOCKED
  DISBURSED
}

enum OnboardingStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ExitType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  CONTRACT_END
}

enum ExitStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  WITHDRAWN
  CLEARANCE_IN_PROGRESS
  SETTLEMENT_PENDING
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExitClearanceDepartment {
  IT
  FINANCE
  ADMIN
  MANAGER
  HR
}

enum ClearanceStatus {
  PENDING
  CLEARED
  WAIVED
  REJECTED
}

enum ExitReasonCategory {
  BETTER_OPPORTUNITY
  CAREER_GROWTH
  HIGHER_COMPENSATION
  HEALTH_PERSONAL
  RELOCATION
  WORK_CULTURE
  MANAGEMENT_ISSUES
  OTHER
}

enum FnFStatus {
  DRAFT
  APPROVED
  PROCESSED
}

enum NotificationType {
  LEAVE_STATUS
  ATTENDANCE_ALERT
  PAYSLIP_RELEASED
  SHIFT_ASSIGNED
  CLEARANCE_TASK
  ANNOUNCEMENT
  SYSTEM
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ---------------------------------------------------------------------------
// 1. Organization (Tenant)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  planTier  String   @default("internal") @map("plan_tier")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users                 User[]
  departments           Department[]
  designations          Designation[]
  grades                Grade[]
  locations             Location[]
  employeeCodeSequences EmployeeCodeSequence[]
  employees             Employee[]
  employeeJobHistories  EmployeeJobHistory[]
  employeeDocuments     EmployeeDocument[]
  shifts                Shift[]
  shiftAssignments      EmployeeShiftAssignment[]
  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  leaveTransactions     LeaveTransaction[]
  attendanceRecords     AttendanceRecord[]
  payrollConfiguration  PayrollConfiguration?
  salaryStructures      SalaryStructure[]
  payrollBatches        PayrollBatch[]
  payslips              Payslip[]
  onboardingCandidates  OnboardingCandidate[]
  onboardingTasks       OnboardingTask[]
  exitRequests          ExitRequest[]
  exitClearanceTasks    ExitClearanceTask[]
  exitInterviews        ExitInterview[]
  fnfSettlements        FnFSettlement[]
  notifications         Notification[]
  announcements         Announcement[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// 2. User (Authentication & RBAC Identity)
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  passwordHash   String    @map("password_hash")
  role           Role      @default(EMPLOYEE)
  employeeId     String?   @unique @map("employee_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")
  createdAnnouncements  Announcement[] @relation("CreatedAnnouncements")

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// 3. Master Lookup Tables (Tenant-Scoped)
// ---------------------------------------------------------------------------

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  codePrefix     String   @map("code_prefix") // e.g., 'ENG', 'HR', 'SLS'
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees             Employee[]
  jobHistories          EmployeeJobHistory[]
  employeeCodeSequences EmployeeCodeSequence[]
  onboardingCandidates  OnboardingCandidate[]
  announcements         Announcement[]

  @@unique([organizationId, name])
  @@unique([organizationId, codePrefix])
  @@map("departments")
}

model Designation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees            Employee[]
  jobHistories         EmployeeJobHistory[]
  onboardingCandidates OnboardingCandidate[]

  @@unique([organizationId, name])
  @@map("designations")
}

model Grade {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String // e.g., 'L1', 'L2', 'M1'
  level          Int?
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees            Employee[]
  jobHistories         EmployeeJobHistory[]
  onboardingCandidates OnboardingCandidate[]

  @@unique([organizationId, name])
  @@map("grades")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String // e.g., 'Mumbai HQ', 'Bengaluru Branch'
  address        String?
  city           String?
  country        String?  @default("India")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees            Employee[]
  onboardingCandidates OnboardingCandidate[]

  @@unique([organizationId, name])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// 4. Atomic Employee Code Sequence (Concurrency Safe)
// ---------------------------------------------------------------------------

model EmployeeCodeSequence {
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  lastNumber     Int      @default(0) @map("last_number")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([organizationId, departmentId])
  @@map("employee_code_sequences")
}

// ---------------------------------------------------------------------------
// 5. Employee Core Record
// ---------------------------------------------------------------------------

model Employee {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  employeeCode   String @map("employee_code") // e.g. ENG-0001

  // Personal Info
  firstName                String    @map("first_name")
  lastName                 String    @map("last_name")
  personalEmail            String?   @map("personal_email")
  phone                    String?
  dateOfBirth              DateTime? @map("date_of_birth")
  gender                   Gender?
  currentAddress           String?   @map("current_address")
  permanentAddress         String?   @map("permanent_address")
  emergencyContactName     String?   @map("emergency_contact_name")
  emergencyContactPhone    String?   @map("emergency_contact_phone")
  emergencyContactRelation String?   @map("emergency_contact_relation")

  // Employment Details
  departmentId       String           @map("department_id") @db.Uuid
  designationId      String           @map("designation_id") @db.Uuid
  gradeId            String?          @map("grade_id") @db.Uuid
  locationId         String?          @map("location_id") @db.Uuid
  reportingManagerId String?          @map("reporting_manager_id") @db.Uuid
  employmentType     EmploymentType   @default(FULL_TIME) @map("employment_type")
  employmentStatus   EmploymentStatus @default(ACTIVE) @map("employment_status")
  dateOfJoining      DateTime         @map("date_of_joining")
  dateOfExit         DateTime?        @map("date_of_exit")
  probationEndDate   DateTime?        @map("probation_end_date")

  // Compensation & Bank Details (RBAC Restricted)
  currency      String?  @default("INR")
  baseSalary    Decimal? @map("base_salary") @db.Decimal(12, 2)
  bankName      String?  @map("bank_name")
  accountNumber String?  @map("account_number")
  ifscOrRouting String?  @map("ifsc_or_routing")
  panNumber     String?  @map("pan_number")
  uanNumber     String?  @map("uan_number")

  // Soft Deletion & Audit Timestamps
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  organization                Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User?
  department                  Department                @relation(fields: [departmentId], references: [id])
  designation                 Designation               @relation(fields: [designationId], references: [id])
  grade                       Grade?                    @relation(fields: [gradeId], references: [id])
  location                    Location?                 @relation(fields: [locationId], references: [id])
  reportingManager            Employee?                 @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  directReports               Employee[]                @relation("ManagerSubordinates")
  jobHistories                EmployeeJobHistory[]      @relation("EmployeeJobHistories")
  jobHistoriesManaged         EmployeeJobHistory[]      @relation("JobHistoryManager")
  documents                   EmployeeDocument[]
  shiftAssignments            EmployeeShiftAssignment[]
  leaveRequests               LeaveRequest[]
  leaveTransactions           LeaveTransaction[]
  attendanceRecords           AttendanceRecord[]
  salaryStructures            SalaryStructure[]
  payslips                    Payslip[]
  onboardingCandidatesManaged OnboardingCandidate[]     @relation("CandidateReportingManager")
  convertedFromCandidate      OnboardingCandidate?      @relation("CandidateConvertedEmployee")
  exitRequests                ExitRequest[]
  fnfSettlements              FnFSettlement[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, deletedAt])
  @@index([organizationId, departmentId])
  @@index([reportingManagerId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// 6. Append-Only Employee Job History Ledger
// ---------------------------------------------------------------------------

model EmployeeJobHistory {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  departmentId       String    @map("department_id") @db.Uuid
  designationId      String    @map("designation_id") @db.Uuid
  gradeId            String?   @map("grade_id") @db.Uuid
  reportingManagerId String?   @map("reporting_manager_id") @db.Uuid
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to") // null means current active state
  reason             String?
  changedByUserId    String?   @map("changed_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee     @relation("EmployeeJobHistories", fields: [employeeId], references: [id], onDelete: Cascade)
  department       Department   @relation(fields: [departmentId], references: [id])
  designation      Designation  @relation(fields: [designationId], references: [id])
  grade            Grade?       @relation(fields: [gradeId], references: [id])
  reportingManager Employee?    @relation("JobHistoryManager", fields: [reportingManagerId], references: [id])

  @@index([organizationId, employeeId])
  @@map("employee_job_histories")
}

// ---------------------------------------------------------------------------
// 7. Employee Documents Metadata
// ---------------------------------------------------------------------------

model EmployeeDocument {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  employeeId       String       @map("employee_id") @db.Uuid
  documentType     DocumentType @map("document_type")
  fileName         String       @map("file_name")
  fileUrl          String       @map("file_url")
  fileSize         Int?         @map("file_size") // in bytes
  uploadedByUserId String?      @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// 8. Shift Management (Module 3)
// ---------------------------------------------------------------------------

model Shift {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  name                    String
  code                    String // e.g. 'GEN', 'MORN', 'NGT'
  startTime               String   @map("start_time") // 'HH:mm' 24h format, e.g. '09:00'
  endTime                 String   @map("end_time") // 'HH:mm' 24h format, e.g. '18:00'
  isOvernight             Boolean  @default(false) @map("is_overnight")
  gracePeriodMinutes      Int      @default(15) @map("grace_period_minutes")
  breakDurationMinutes    Int      @default(60) @map("break_duration_minutes")
  halfDayThresholdMinutes Int      @default(240) @map("half_day_threshold_minutes") // 4 hours
  fullDayThresholdMinutes Int      @default(480) @map("full_day_threshold_minutes") // 8 hours
  isDefault               Boolean  @default(false) @map("is_default")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments       EmployeeShiftAssignment[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("shifts")
}

model EmployeeShiftAssignment {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  employeeId       String      @map("employee_id") @db.Uuid
  shiftId          String      @map("shift_id") @db.Uuid
  effectiveFrom    DateTime    @map("effective_from")
  effectiveTo      DateTime?   @map("effective_to") // null means current active assignment
  weeklyOffDays    DayOfWeek[] @default([SATURDAY, SUNDAY]) @map("weekly_off_days")
  assignedByUserId String?     @map("assigned_by_user_id") @db.Uuid
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift        Shift        @relation(fields: [shiftId], references: [id])

  @@index([organizationId, employeeId, effectiveTo])
  @@map("employee_shift_assignments")
}

// ---------------------------------------------------------------------------
// 9. Leave Management (Module 5)
// ---------------------------------------------------------------------------

model LeaveType {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  name               String
  code               String // e.g. 'CL', 'SL', 'PL', 'LWP'
  description        String?
  isPaid             Boolean               @default(true) @map("is_paid")
  daysAllowedPerYear Decimal               @default(0.00) @map("days_allowed_per_year") @db.Decimal(5, 2)
  accrualFrequency   LeaveAccrualFrequency @default(MONTHLY) @map("accrual_frequency")
  carryForwardLimit  Decimal               @default(0.00) @map("carry_forward_limit") @db.Decimal(5, 2)
  requiresApproval   Boolean               @default(true) @map("requires_approval")
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     LeaveRequest[]
  transactions LeaveTransaction[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("leave_types")
}

model LeaveRequest {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  employeeId       String               @map("employee_id") @db.Uuid
  leaveTypeId      String               @map("leave_type_id") @db.Uuid
  startDate        DateTime             @map("start_date")
  endDate          DateTime             @map("end_date")
  isHalfDay        Boolean              @default(false) @map("is_half_day")
  halfDaySession   LeaveHalfDaySession? @map("half_day_session")
  totalDays        Decimal              @map("total_days") @db.Decimal(5, 2)
  reason           String
  status           LeaveRequestStatus   @default(PENDING)
  appliedAt        DateTime             @default(now()) @map("applied_at")
  actionedByUserId String?              @map("actioned_by_user_id") @db.Uuid
  actionedAt       DateTime?            @map("actioned_at")
  rejectionReason  String?              @map("rejection_reason")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType         LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  transactions      LeaveTransaction[]
  attendanceRecords AttendanceRecord[]

  @@index([organizationId, employeeId, status])
  @@index([organizationId, startDate, endDate])
  @@map("leave_requests")
}

model LeaveTransaction {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  leaveTypeId     String               @map("leave_type_id") @db.Uuid
  transactionType LeaveTransactionType @map("transaction_type")
  days            Decimal              @db.Decimal(5, 2) // positive for credit/accrual, negative for debit/application
  balanceAfter    Decimal              @map("balance_after") @db.Decimal(5, 2)
  leaveRequestId  String?              @map("leave_request_id") @db.Uuid
  effectiveDate   DateTime             @default(now()) @map("effective_date")
  notes           String?
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, leaveTypeId])
  @@map("leave_transactions")
}

// ---------------------------------------------------------------------------
// 10. Attendance Management (Module 4)
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  employeeId          String           @map("employee_id") @db.Uuid
  date                DateTime         @map("date")
  status              AttendanceStatus @default(ABSENT)
  shiftId             String?          @map("shift_id") @db.Uuid
  checkInTime         DateTime?        @map("check_in_time")
  checkOutTime        DateTime?        @map("check_out_time")
  totalActiveMinutes  Int?             @map("total_active_minutes")
  isLate              Boolean          @default(false) @map("is_late")
  lateMinutes         Int?             @map("late_minutes")
  isHalfDay           Boolean          @default(false) @map("is_half_day")
  leaveRequestId      String?          @map("leave_request_id") @db.Uuid
  isPaid              Boolean          @default(true) @map("is_paid")
  punchSource         PunchSource      @default(WEB) @map("punch_source")
  remarks             String?
  regularizedByUserId String?          @map("regularized_by_user_id") @db.Uuid
  regularizedAt       DateTime?        @map("regularized_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift        Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date, status])
  @@index([organizationId, employeeId, status])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// 11. Payroll Management (Module 6)
// ---------------------------------------------------------------------------

model PayrollConfiguration {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @unique @map("organization_id") @db.Uuid
  pfCeilingAmount            Decimal  @default(15000.00) @map("pf_ceiling_amount") @db.Decimal(12, 2)
  applyPfCeiling             Boolean  @default(true) @map("apply_pf_ceiling")
  pfEmployeeRate             Decimal  @default(12.00) @map("pf_employee_rate") @db.Decimal(5, 2)
  pfEmployerRate             Decimal  @default(12.00) @map("pf_employer_rate") @db.Decimal(5, 2)
  ptAmount                   Decimal  @default(200.00) @map("pt_amount") @db.Decimal(12, 2)
  ptSalaryThreshold          Decimal  @default(10000.00) @map("pt_salary_threshold") @db.Decimal(12, 2)
  roundToWholeRupee          Boolean  @default(true) @map("round_to_whole_rupee")
  basicPercentage            Decimal  @default(50.00) @map("basic_percentage") @db.Decimal(5, 2)
  hraPercentage              Decimal  @default(25.00) @map("hra_percentage") @db.Decimal(5, 2)
  specialAllowancePercentage Decimal  @default(25.00) @map("special_allowance_percentage") @db.Decimal(5, 2)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payroll_configurations")
}

model SalaryStructure {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  annualCtc        Decimal   @map("annual_ctc") @db.Decimal(12, 2)
  monthlyGross     Decimal   @map("monthly_gross") @db.Decimal(12, 2)
  basicSalary      Decimal   @map("basic_salary") @db.Decimal(12, 2)
  hra              Decimal   @map("hra") @db.Decimal(12, 2)
  specialAllowance Decimal   @map("special_allowance") @db.Decimal(12, 2)
  effectiveFrom    DateTime  @map("effective_from")
  effectiveTo      DateTime? @map("effective_to") // null means current active structure
  revisionReason   String?   @map("revision_reason")
  revisedByUserId  String?   @map("revised_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@index([organizationId, employeeId, effectiveTo])
  @@map("salary_structures")
}

model PayrollBatch {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  year              Int
  month             Int // 1 - 12
  status            PayrollBatchStatus @default(DRAFT)
  totalEmployees    Int                @default(0) @map("total_employees")
  totalGrossPay     Decimal            @default(0.00) @map("total_gross_pay") @db.Decimal(12, 2)
  totalDeductions   Decimal            @default(0.00) @map("total_deductions") @db.Decimal(12, 2)
  totalNetPay       Decimal            @default(0.00) @map("total_net_pay") @db.Decimal(12, 2)
  totalEmployerPf   Decimal            @default(0.00) @map("total_employer_pf") @db.Decimal(12, 2)
  lockedAt          DateTime?          @map("locked_at")
  lockedByUserId    String?            @map("locked_by_user_id") @db.Uuid
  disbursedAt       DateTime?          @map("disbursed_at")
  disbursedByUserId String?            @map("disbursed_by_user_id") @db.Uuid
  paymentReference  String?            @map("payment_reference")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_batches")
}

model Payslip {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid
  payrollBatchId       String  @map("payroll_batch_id") @db.Uuid
  employeeId           String  @map("employee_id") @db.Uuid
  salaryStructureId    String  @map("salary_structure_id") @db.Uuid
  totalMonthDays       Int     @map("total_month_days")
  payableDays          Decimal @map("payable_days") @db.Decimal(5, 2)
  lwpDays              Decimal @map("lwp_days") @db.Decimal(5, 2)
  unexcusedAbsenceDays Decimal @map("unexcused_absence_days") @db.Decimal(5, 2)

  nominalGross            Decimal @map("nominal_gross") @db.Decimal(12, 2)
  nominalBasic            Decimal @map("nominal_basic") @db.Decimal(12, 2)
  nominalHra              Decimal @map("nominal_hra") @db.Decimal(12, 2)
  nominalSpecialAllowance Decimal @map("nominal_special_allowance") @db.Decimal(12, 2)

  earnedBasic            Decimal @map("earned_basic") @db.Decimal(12, 2)
  earnedHra              Decimal @map("earned_hra") @db.Decimal(12, 2)
  earnedSpecialAllowance Decimal @map("earned_special_allowance") @db.Decimal(12, 2)
  earnedGross            Decimal @map("earned_gross") @db.Decimal(12, 2)

  employeePf      Decimal @map("employee_pf") @db.Decimal(12, 2)
  professionalTax Decimal @map("professional_tax") @db.Decimal(12, 2)
  totalDeductions Decimal @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal @map("net_pay") @db.Decimal(12, 2)
  employerPf      Decimal @map("employer_pf") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollBatch    PayrollBatch    @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)

  @@unique([payrollBatchId, employeeId])
  @@index([organizationId, employeeId])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// 12. Employee Onboarding (Module 8)
// ---------------------------------------------------------------------------

model OnboardingCandidate {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  firstName                String    @map("first_name")
  lastName                 String    @map("last_name")
  personalEmail            String    @map("personal_email")
  phone                    String?
  dateOfBirth              DateTime? @map("date_of_birth")
  gender                   Gender?
  currentAddress           String?   @map("current_address")
  permanentAddress         String?   @map("permanent_address")
  emergencyContactName     String?   @map("emergency_contact_name")
  emergencyContactPhone    String?   @map("emergency_contact_phone")
  emergencyContactRelation String?   @map("emergency_contact_relation")

  // Target Employment Details
  departmentId        String   @map("department_id") @db.Uuid
  designationId       String   @map("designation_id") @db.Uuid
  gradeId             String?  @map("grade_id") @db.Uuid
  locationId          String?  @map("location_id") @db.Uuid
  reportingManagerId  String?  @map("reporting_manager_id") @db.Uuid
  proposedJoiningDate DateTime @map("proposed_joining_date")
  offeredCtc          Decimal? @map("offered_ctc") @db.Decimal(12, 2)

  // Banking & Statutory Info (Submitted during pre-boarding)
  bankName      String? @map("bank_name")
  accountNumber String? @map("account_number")
  ifscOrRouting String? @map("ifsc_or_routing")
  panNumber     String? @map("pan_number")
  uanNumber     String? @map("uan_number")

  // State Tracking
  status              OnboardingStatus @default(INVITED)
  convertedEmployeeId String?          @unique @map("converted_employee_id") @db.Uuid
  notes               String?
  invitedByUserId     String?          @map("invited_by_user_id") @db.Uuid
  convertedAt         DateTime?        @map("converted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department       @relation(fields: [departmentId], references: [id])
  designation       Designation      @relation(fields: [designationId], references: [id])
  grade             Grade?           @relation(fields: [gradeId], references: [id])
  location          Location?        @relation(fields: [locationId], references: [id])
  reportingManager  Employee?        @relation("CandidateReportingManager", fields: [reportingManagerId], references: [id])
  convertedEmployee Employee?        @relation("CandidateConvertedEmployee", fields: [convertedEmployeeId], references: [id])
  tasks             OnboardingTask[]

  @@unique([organizationId, personalEmail])
  @@index([organizationId, status])
  @@map("onboarding_candidates")
}

model OnboardingTask {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  candidateId       String               @map("candidate_id") @db.Uuid
  title             String
  description       String?
  isMandatory       Boolean              @default(true) @map("is_mandatory")
  status            OnboardingTaskStatus @default(PENDING)
  completedByUserId String?              @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime?            @map("completed_at")
  notes             String?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    OnboardingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId])
  @@map("onboarding_tasks")
}

// ---------------------------------------------------------------------------
// 13. Offboarding & Exit Management (Module 9)
// ---------------------------------------------------------------------------

model ExitRequest {
  id                     String     @id @default(uuid()) @db.Uuid
  organizationId         String     @map("organization_id") @db.Uuid
  employeeId             String     @map("employee_id") @db.Uuid
  exitType               ExitType   @default(RESIGNATION) @map("exit_type")
  resignationDate        DateTime   @default(now()) @map("resignation_date")
  reason                 String
  noticePeriodDays       Int        @default(30) @map("notice_period_days")
  proposedLastWorkingDay DateTime   @map("proposed_last_working_day")
  approvedLastWorkingDay DateTime?  @map("approved_last_working_day")
  status                 ExitStatus @default(PENDING_APPROVAL)

  // Dual Approval (Manager & HR)
  managerApprovalStatus ApprovalStatus @default(PENDING) @map("manager_approval_status")
  managerComments       String?        @map("manager_comments")
  managerApprovedAt     DateTime?      @map("manager_approved_at")
  hrApprovalStatus      ApprovalStatus @default(PENDING) @map("hr_approval_status")
  hrComments            String?        @map("hr_comments")
  hrApprovedAt          DateTime?      @map("hr_approved_at")

  finalizedAt       DateTime? @map("finalized_at")
  finalizedByUserId String?   @map("finalized_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clearanceTasks ExitClearanceTask[]
  exitInterview  ExitInterview?
  fnfSettlement  FnFSettlement?

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@map("exit_requests")
}

model ExitClearanceTask {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  exitRequestId   String                  @map("exit_request_id") @db.Uuid
  departmentType  ExitClearanceDepartment @map("department_type")
  title           String
  description     String?
  isMandatory     Boolean                 @default(true) @map("is_mandatory")
  status          ClearanceStatus         @default(PENDING)
  remarks         String?
  clearedByUserId String?                 @map("cleared_by_user_id") @db.Uuid
  clearedAt       DateTime?               @map("cleared_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exitRequest  ExitRequest  @relation(fields: [exitRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, exitRequestId])
  @@map("exit_clearance_tasks")
}

model ExitInterview {
  id                    String             @id @default(uuid()) @db.Uuid
  organizationId        String             @map("organization_id") @db.Uuid
  exitRequestId         String             @unique @map("exit_request_id") @db.Uuid
  reasonCategory        ExitReasonCategory @map("reason_category")
  companyCultureRating  Int                @map("company_culture_rating") // 1-5
  managementRating      Int                @map("management_rating") // 1-5
  workLifeBalanceRating Int                @map("work_life_balance_rating") // 1-5
  compensationRating    Int                @map("compensation_rating") // 1-5
  wouldRecommendCompany Boolean            @map("would_recommend_company")
  feedback              String?
  submittedAt           DateTime           @default(now()) @map("submitted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exitRequest  ExitRequest  @relation(fields: [exitRequestId], references: [id], onDelete: Cascade)

  @@map("exit_interviews")
}

model FnFSettlement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  exitRequestId  String   @unique @map("exit_request_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  settlementDate DateTime @default(now()) @map("settlement_date")
  lastWorkingDay DateTime @map("last_working_day")

  // Earnings in Final Wage Period
  payableDays            Decimal @map("payable_days") @db.Decimal(5, 2)
  earnedBasic            Decimal @map("earned_basic") @db.Decimal(12, 2)
  earnedHra              Decimal @map("earned_hra") @db.Decimal(12, 2)
  earnedSpecialAllowance Decimal @map("earned_special_allowance") @db.Decimal(12, 2)
  earnedGross            Decimal @map("earned_gross") @db.Decimal(12, 2)

  // Leave Encashment
  encashableLeaveDays   Decimal @map("encashable_leave_days") @db.Decimal(5, 2)
  dailyBasicRate        Decimal @map("daily_basic_rate") @db.Decimal(12, 2)
  leaveEncashmentAmount Decimal @map("leave_encashment_amount") @db.Decimal(12, 2)

  // Additional Additions
  gratuityAmount Decimal @default(0) @map("gratuity_amount") @db.Decimal(12, 2)
  bonusAmount    Decimal @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  totalAdditions Decimal @map("total_additions") @db.Decimal(12, 2)

  // Deductions
  noticeShortfallDays    Int     @default(0) @map("notice_shortfall_days")
  noticeDeductionAmount  Decimal @default(0) @map("notice_deduction_amount") @db.Decimal(12, 2)
  employeePf             Decimal @default(0) @map("employee_pf") @db.Decimal(12, 2)
  professionalTax        Decimal @default(0) @map("professional_tax") @db.Decimal(12, 2)
  otherDeductions        Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)
  otherDeductionsRemarks String? @map("other_deductions_remarks")
  totalDeductions        Decimal @map("total_deductions") @db.Decimal(12, 2)

  // Final Net Settlement
  netSettlementAmount Decimal   @map("net_settlement_amount") @db.Decimal(12, 2)
  status              FnFStatus @default(DRAFT)
  approvedByUserId    String?   @map("approved_by_user_id") @db.Uuid
  approvedAt          DateTime? @map("approved_at")
  remarks             String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exitRequest  ExitRequest  @relation(fields: [exitRequestId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("fnf_settlements")
}

// ---------------------------------------------------------------------------
// 12. Notification Engine & Announcements (Module 11)
// ---------------------------------------------------------------------------

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  recipientUserId String           @map("recipient_user_id") @db.Uuid
  senderUserId    String?          @map("sender_user_id") @db.Uuid
  type            NotificationType
  title           String
  message         String
  actionUrl       String?          @map("action_url")
  metadata        Json?
  isRead          Boolean          @default(false) @map("is_read")
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientUser User         @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  senderUser    User?        @relation("SentNotifications", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, recipientUserId, isRead])
  @@index([organizationId, recipientUserId, createdAt])
  @@map("notifications")
}

model Announcement {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  title              String
  content            String
  priority           AnnouncementPriority @default(NORMAL)
  targetDepartmentId String?              @map("target_department_id") @db.Uuid
  createdByUserId    String               @map("created_by_user_id") @db.Uuid
  isActive           Boolean              @default(true) @map("is_active")
  expiresAt          DateTime?            @map("expires_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  // Relations
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("CreatedAnnouncements", fields: [createdByUserId], references: [id], onDelete: Cascade)
  targetDepartment Department?  @relation(fields: [targetDepartmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, isActive, createdAt])
  @@index([organizationId, targetDepartmentId])
  @@map("announcements")
}
