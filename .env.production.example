# ==============================================================================
# PlanetU HRMS - Production Environment Configuration
# ==============================================================================

# 1. Cloud PostgreSQL Connection String (e.g. from Neon, Supabase, Render, or Railway)
DATABASE_URL="postgresql://planetu_admin:your_secure_password@your-db-host.neon.tech/planetu_hrms?sslmode=require"

# 2. Server Configuration
NODE_ENV=production
PORT=3000

# 3. Security & JWT Secrets (Generate secure random 64-char strings)
JWT_SECRET=super_secret_jwt_key_change_in_production_9f82d1c73a4b
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_8e71b2a54c3d

# 4. Optional: Custom Domain or Frontend URL for CORS (if not using single-domain serving)
# FRONTEND_URL=https://hrms.yourcompany.com

# 5. Optional: Real-Time Email Delivery (Gmail SMTP or Brevo/SendGrid)
# If omitted, the system operates in zero-cost simulated notification mode
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_company_hr@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="PlanetU HRMS <your_company_hr@gmail.com>"
